APP_NAME=Laravel
# Replace the example hosts and database placeholders with SiteGround values.
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
# Optional extra API key. Protected routes still require Sanctum authentication.
HAMACAS_API_KEY=
CORS_ALLOWED_ORIGINS=https://app.example.com,https://www.example.com
SANCTUM_STATEFUL_DOMAINS=app.example.com,api.example.com
# Personal access token expiration in minutes (30 days).
SANCTUM_EXPIRATION=43200

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=your-siteground-db-host
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=replace_with_database_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Set to .example.com only when the frontend and API need a shared subdomain cookie.
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
# Local disk storage is persistent on SiteGround; preserve storage/ across releases.
# Product photos are stored on the public disk under storage/app/public.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Commercial rates are percentages; invoices store their fractional values.
COMMERCIAL_IVA_RATE=15
COMMERCIAL_IR_RATE=2

HAMACAS_MONEDA=C$
HAMACAS_EMPRESA_NOMBRE=Hamacas Nica
HAMACAS_EMPRESA_RUC=
HAMACAS_EMPRESA_DIRECCION=
HAMACAS_EMPRESA_CIUDAD=
HAMACAS_EMPRESA_PAIS=
HAMACAS_EMPRESA_TELEFONO=
HAMACAS_EMPRESA_CORREO=
HAMACAS_EMPRESA_WEB=
HAMACAS_EMPRESA_FACEBOOK=
HAMACAS_EMPRESA_INSTAGRAM=
HAMACAS_EMPRESA_YOUTUBE=
HAMACAS_EMPRESA_LOGO=
HAMACAS_EMPRESA_FIRMA=
HAMACAS_EMPRESA_SELLO=
PROFORMA_CONDICIONES_PAGO=

VITE_APP_NAME="${APP_NAME}"
